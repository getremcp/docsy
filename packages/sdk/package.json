{
  "name": "@remcp/docsy-sdk",
  "version": "0.1.2",
  "description": "Docsy TypeScript SDK: version-aware developer documentation and source-linked search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src test --ext .ts,.tsx,.js,.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.0.4"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getremcp/docsy.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://docsy.remcp.site/docs",
  "bugs": {
    "url": "https://github.com/getremcp/docsy/issues"
  },
  "keywords": [
    "docsy",
    "developer-documentation",
    "typescript",
    "sdk",
    "mcp",
    "source-links",
    "search"
  ],
  "engines": {
    "node": ">=22"
  }
}
